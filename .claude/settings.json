{
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --force-if-includes:*)",
      "Bash(git push -f:*)",

      "Bash(gh pr merge)",
      "Bash(gh pr merge:*)",
      "Bash(git merge)",
      "Bash(git merge:*)",

      "Bash(git push origin main)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main)",
      "Bash(git push -u origin main:*)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push origin HEAD:main:*)",

      "Bash(git push origin master)",
      "Bash(git push origin master:*)",
      "Bash(git push -u origin master)",
      "Bash(git push -u origin master:*)",
      "Bash(git push origin HEAD:master)",
      "Bash(git push origin HEAD:master:*)",

      "Bash(git push origin stable)",
      "Bash(git push origin stable:*)",
      "Bash(git push -u origin stable)",
      "Bash(git push -u origin stable:*)",
      "Bash(git push origin HEAD:stable)",
      "Bash(git push origin HEAD:stable:*)",

      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(.github/**)",
      "Write(.github/**)",
      "Edit(**/build.rs)",
      "Write(**/build.rs)",
      "Edit(**/.npmrc)",
      "Write(**/.npmrc)",
      "Edit(**/.cargo/config*)",
      "Write(**/.cargo/config*)",
      "Edit(.git/hooks/**)",
      "Write(.git/hooks/**)",

      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/id_rsa*)",
      "Read(**/*.pem)"
    ],
    "allow": [
      "Bash(gh pr comment:*)"
    ]
  }
}
